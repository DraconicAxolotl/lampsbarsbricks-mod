{
  "schemaVersion": 1,
  "id": "lampsbarsbricks",
  "version": "${version}",

  "name": "Lamps Bars Bricks",
  "description": "Adds Redstone lamps, Iron Bars, and Stone Bricks to Beta 1.7.3 STAPI",
  "authors": [
    "DraconicAxolotl"
  ],

  "license": "CC0-1.0",
  "icon": "assets/lampsbarsbricks/icon.png",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "io.github.DraconicAxolotl.lampsbarsbricks.events.init.InitListener",
      "io.github.DraconicAxolotl.lampsbarsbricks.events.init.BlockListener",
      "io.github.DraconicAxolotl.lampsbarsbricks.events.init.ItemListener",
      "io.github.DraconicAxolotl.lampsbarsbricks.events.init.RecipeListener"
    ],
    "stationapi:event_bus_client": [
      "io.github.DraconicAxolotl.lampsbarsbricks.events.init.client.TextureListener"
    ],
    "stationapi:event_bus_server": [
    ]
  },
  "mixins": [
    "lampsbarsbricks.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
